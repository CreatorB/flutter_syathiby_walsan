# ==========================================================
# SECURITY HEADERS (Geolocation + Mixed Content Fix)
# ==========================================================
<IfModule mod_headers.c>
  # Izinkan akses geolocation untuk Safari iOS
  Header always set Permissions-Policy "geolocation=(*), camera=(*), microphone=(*)"
  # Paksa upgrade HTTP ke HTTPS untuk semua resource (fix mixed content)
  Header always set Content-Security-Policy "upgrade-insecure-requests"

  # CRITICAL: Prevent caching for index.html and version.json
  # This ensures users always get latest version after deployment
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CRITICAL (ditambah 8 Sep 2026): entry point Flutter TIDAK ber-hash nama file.
  #
  # Aturan `ExpiresByType application/javascript "access plus 1 year"` di bawah
  # diberi komentar "they have hash in filename" -- itu BENAR untuk aset di
  # assets/ dan canvaskit/, tapi SALAH untuk berkas berikut yang namanya tetap
  # sama di setiap build. Akibatnya Cloudflare menyimpannya 1 tahun.
  #
  # Terbukti 8 Sep 2026: `main.dart.js` di walsan.syathiby.id disajikan dari
  # cache edge Cloudflare bertanggal 1 Sep (cf-cache-status: HIT, Age: 542657
  # detik = 6,3 hari) padahal berkas di server sudah diperbarui 6 Sep. Deploy
  # 6 Sep TIDAK PERNAH SAMPAI ke pengguna, dan tanpa perbaikan ini deploy
  # berikutnya pun tidak akan sampai.
  #
  # `flutter_bootstrap.js` memang diberi `?v=` manual di index.html, tapi berkas
  # yang dimuatnya (`main.dart.js`) tidak -- jadi bootstrap ikut baru sementara
  # isi aplikasinya tetap lama. Justru kombinasi paling menyesatkan saat debug.
  # Blok ini disalin PERSIS dari apps/flutter_syathiby/web/.htaccess baris 89,
  # yang sudah terbukti bekerja: main.dart.js di aplikasi.syathiby.id/web/
  # dilaporkan `cf-cache-status: DYNAMIC` (tidak di-cache edge), sedangkan
  # walsan `HIT` dengan umur 6,3 hari. Walsan tidak pernah ikut diperbaiki.
  <FilesMatch "^(main\.dart\.js|flutter_service_worker\.js|flutter_bootstrap\.js|flutter\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ==========================================================
# PAKSA HTTPS
# ==========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect HTTP ke HTTPS (skip kalau Nginx/Cloudflare kirim X-Forwarded-Proto=https,
  # karena %{HTTPS} di Apache selalu off di belakang reverse-proxy SSL-terminator)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Flutter web SPA routing - arahkan semua ke index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ==========================================================
# MIME Types
# ==========================================================
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/json .map
  AddType application/javascript .js
</IfModule>

# ==========================================================
# Caching untuk performa (static assets only)
# ==========================================================
<IfModule mod_expires.c>
  ExpiresActive On
  # Long cache for static assets (they have hash in filename)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # NO CACHE for HTML and JSON (always fresh for updates)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ==========================================================
# VERSION CHECK ENDPOINT
# ==========================================================
# Allow version.json to be accessed without caching
<IfModule mod_headers.c>
  <Files "version.json">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Access-Control-Allow-Origin "*"
  </Files>
</IfModule>
