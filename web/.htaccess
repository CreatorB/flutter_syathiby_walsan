# ==========================================================
# SECURITY HEADERS (Geolocation + Mixed Content Fix)
# ==========================================================
<IfModule mod_headers.c>
  # Izinkan akses geolocation untuk Safari iOS
  Header always set Permissions-Policy "geolocation=(*), camera=(*), microphone=(*)"
  # Paksa upgrade HTTP ke HTTPS untuk semua resource (fix mixed content)
  Header always set Content-Security-Policy "upgrade-insecure-requests"

  # CRITICAL: Prevent caching for index.html and version.json
  # This ensures users always get latest version after deployment
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

</IfModule>

# ==========================================================
# PAKSA HTTPS
# ==========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect HTTP ke HTTPS (skip kalau Nginx/Cloudflare kirim X-Forwarded-Proto=https,
  # karena %{HTTPS} di Apache selalu off di belakang reverse-proxy SSL-terminator)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Flutter web SPA routing - arahkan semua ke index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ==========================================================
# MIME Types
# ==========================================================
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/json .map
  AddType application/javascript .js
</IfModule>

# ==========================================================
# Caching untuk performa (static assets only)
# ==========================================================
<IfModule mod_expires.c>
  ExpiresActive On
  # Long cache for static assets (they have hash in filename)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # NO CACHE for HTML and JSON (always fresh for updates)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ==========================================================
# JANGAN CACHE entry point Flutter web
# ==========================================================
# CATATAN PENTING: blok ini TIDAK menyelesaikan masalah cache di produksi.
#
# nginx (template Hestia) melayani file statis LANGSUNG DARI DISK dengan
# `expires max`, tanpa meneruskan ke Apache -- jadi .htaccess tidak pernah
# dibaca untuk berkas-berkas ini. Diuji 8 Sep 2026: perbaikan versi pertama
# ditaruh di sini, di-deploy, dan header tetap max-age=315360000.
#
# Perbaikan yang SEBENARNYA bekerja ada di sisi server:
#   /home/hestiaadmin/conf/web/walsan.syathiby.id/nginx.ssl.conf_flutter_cache
# (lihat AGENTS.md Section 9.10 bagian "AKAR MASALAH CACHE FLUTTER WEB").
#
# Blok ini tetap dipertahankan sebagai jaring pengaman: kalau suatu saat berkas
# ini dilayani Apache (hosting lain, konfigurasi nginx berubah, atau dijalankan
# di lokal), aturannya sudah benar. Posisinya SETELAH mod_expires memang wajib
# -- mod_expires menulis Cache-Control belakangan dan akan menimpanya.
#
# main.dart.js, flutter_service_worker.js, flutter_bootstrap.js, dan flutter.js
# TIDAK punya hash di nama file (beda dengan aset di assets/ dan canvaskit/),
# jadi aturan "1 year" di atas mengunci pengguna di build LAMA.
<IfModule mod_headers.c>
  <FilesMatch "^(main\.dart\.js|flutter_service_worker\.js|flutter_bootstrap\.js|flutter\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ==========================================================
# VERSION CHECK ENDPOINT
# ==========================================================
# Allow version.json to be accessed without caching
<IfModule mod_headers.c>
  <Files "version.json">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Access-Control-Allow-Origin "*"
  </Files>
</IfModule>
