app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# Environment variables (PENTING: jangan commit secrets)
.env
.env.*
!.env.example

# Freezed files
**/*.freezed.dart

# Json Serializable files
**/*.g.dart

